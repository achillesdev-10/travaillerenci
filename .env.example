# =============================================================================
# TravaillerEnCi — Variables d'environnement
# Copie ce fichier en .env.local (gitignoré) pour le développement local.
# En production, définis ces variables dans GitHub Actions Secrets / Vercel.
# =============================================================================

# --- Supabase (base de données en production) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- IA : Gemini (classification + réécriture des contenus scrapés) ---
# Clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Modèle Gemini (défaut : gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# --- IA : Groq (fallback si Gemini échoue) ---
# Console Groq : https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Modèle Groq (défaut : qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Scraper ---
# Sites à scraper (défaut : educarriere,emploici,boursedetude)
# SCRAPER_SITES=educarriere,emploici,boursedetude
# Sources de concours (défaut : toutes)
# EXAM_SOURCES=gucaci,ena,infas,cafop,gendarmerie,police
# Désactiver l'IA (classification heuristique uniquement)
# TRAVAILLERENCI_NO_AI=1
# Activer les données de démonstration (tests uniquement)
# TRAVAILLERENCI_DEMO_DATA=1
# Désactiver la vérification TLS (certificats incomplets sur certains sites CI)
# TRAVAILLERENCI_VERIFY_SSL=0

# --- Alerte Scraper (optionnel) ---
# Canal email (Resend) — alerter quand une source échoue ou chute sous le seuil
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=TravaillerEnCi <noreply@travaillerenci.ci>
ADMIN_EMAIL=achillesdev10@gmail.com
# Canal WhatsApp (Meta Cloud API) — alerter le SCRAPER
WHATSAPP_NOTIFY_ENABLED=1
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
ADMIN_WHATSAPP_PHONE=+22500000000

# --- Notifications candidat (alert_digest.py) ---
# URL publique du site
NEXT_PUBLIC_SITE_URL=https://travaillerenci.vercel.app
# Fenêtre de nouveauté pour les alertes (heures, défaut 24)
ALERT_DIGEST_LOOKBACK_HOURS=24

# --- Auth admin (2FA / session) ---
# Secret TOTP pour l'authentification admin (optionnel)
# ADMIN_TOTP_SECRET=your-totp-secret
