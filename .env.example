# =============================================================================
#  TravaillerEnCi — variables d'environnement (NOMS UNIQUEMENT, jamais de secrets)
#
#  Copier ce fichier vers `.env.local` (local, gitignoré) ou définir chaque
#  variable dans Vercel → Settings → Environment Variables (production).
#
#  ⚠️ NE JAMAIS committer de clé/valeur secrète. Si une clé fuite dans Git,
#  révoquez-la immédiatement puis remplacez-la.
# =============================================================================

# --- Base de données ----------------------------------------------------------
# NEXT_PUBLIC_DB_PROVIDER=sqlite            # sqlite (local) | supabase (production)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=                # serveur uniquement (écritures admin, contourne la RLS)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sessions (signature HMAC des cookies httpOnly) ---------------------------
# ADMIN_SESSION_SECRET=                     # secret aléatoire long, serveur uniquement
# JWT_SECRET=                               # repli utilisé si ADMIN_SESSION_SECRET absent

# --- Site ----------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://travaillerenci.vercel.app
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=          # 1 pour afficher « Se connecter avec Google »
# GOOGLE_CLIENT_ID=                         # credentials OAuth « Application Web » (Google Cloud Console)
# GOOGLE_CLIENT_SECRET=

# --- Authentification -----------------------------------------------------------
# Vérification d'email par lien. DÉSACTIVÉE par défaut : le compte est créé
# directement vérifié et utilisable immédiatement (aucune dépendance à Resend).
# Réactiver APRÈS l'achat du domaine + configuration Resend (docs/EMAIL_DELIVERY.md) :
# EMAIL_VERIFICATION_ENABLED=false

# --- Emails transactionnels (Resend) — optionnel à ce stade ----------------------
# RESEND_API_KEY=
# EMAIL_FROM=TravaillerEnCi <noreply@travaillerenci.ci>

# --- IA : enrichissement du scraper (Gemini principal, Groq en repli) ------------
# GEMINI_API_KEY=                           # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_FALLBACKS=gemini-3-flash-preview
# GROQ_API_KEY=                             # https://console.groq.com/keys — repli si Gemini échoue
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Distribution sociale (Facebook / LinkedIn) — tout côté serveur ----------------
# Le site reste la source : une publication n'est diffusée QUE si elle est publiée
# sur TravaillerEnCi (status='published'). Le worker est /api/cron/social-publisher
# (Vercel Cron) protégé par CRON_SECRET.
#
# Facebook (Page officielle web.facebook.com/travaillerenci — Graph API) :
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_PAGE_ID=                        # ID numérique de la Page
# FACEBOOK_ACCESS_TOKEN=                   # Token longue durée de la Page (jamais dans le frontend)
#
# LinkedIn (Posts API — nécessite une vraie Page Organisation) :
# Tant que la destination fournie (linkedin.com/in/travailler-en-ci) n'est pas une
# Page Organisation, laisser VIDE : l'intégration affiche « LinkedIn non configuré »
# et s'activera automatiquement une fois la Page connectée.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORGANIZATION_ID=                # ID numérique de la Page Organisation
# LINKEDIN_ACCESS_TOKEN=                   # Token OAuth membre avec w_organization_social
#
# File d'attente & limites (configurables) :
# Publication automatique FACEBOOK UNIQUEMENT pour le moment. Réactiver LinkedIn
# UNIQUEMENT quand la Page Organisation sera connectée :
# SOCIAL_LINKEDIN_ENABLED=false
# SOCIAL_FACEBOOK_DAILY_LIMIT=5            # publications max / jour sur Facebook
# SOCIAL_LINKEDIN_DAILY_LIMIT=3            # publications max / jour sur LinkedIn
# SOCIAL_MAX_RETRIES=3                     # tentatives max avant statut 'failed'
# SOCIAL_PUBLISH_SLOTS=09:00,11:30,14:00,16:30,18:30   # créneaux de publication progressive
# SOCIAL_DRY_RUN=true                      # true → génère texte/image/URL/payload SANS publier
# SOCIAL_AI_ENABLED=false                  # true → amélioration IA des textes (validée contre les faits)
#
# Sécurité du worker :
# CRON_SECRET=                             # secret long, envoyé par Vercel Cron (Authorization: Bearer)

# --- Outils de développement (locaux / scripts uniquement) -----------------------
# SCRAPER_SITES=educarriere,emploici,boursedetude   # filtre des sources (défaut sinon)
# EXAM_SOURCES=gucaci,ena,infas                     # filtre des sources concours (optionnel)
# SUPABASE_ACCESS_TOKEN=sbp_…                       # Personal Access Token Supabase : scripts/apply-*-migrations.ts
