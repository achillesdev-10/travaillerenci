# ============================================================================
#  TravaillerEnCi — Variables d'environnement (copier vers .env.local)
#  Chaque variable est optionnelle : le site fonctionne en mode dégradé
#  (SQLite + sans notifications) si les clés sont absentes.
# ============================================================================

# ---------------------------------------------------------------------------
# Base de données
#   sqlite   → fichier local ./data/travaillerenci.sqlite3 (développement)
#   supabase → Supabase (production, Vercel : filesystem en lecture seule)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DB_PROVIDER=sqlite
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Personnel Access Token Supabase — applique les migrations via scripts/apply-content-migrations.ts
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# URL publique du site (liens emails, SEO, partage WhatsApp…)
#   Défaut dev : http://localhost:3000 — défaut prod : https://travaillerenci.vercel.app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Emails transactionnels (Resend — https://resend.com/api-keys)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Expéditeur vérifié sur Resend (défaut : TravaillerEnCi <noreply@travaillerenci.ci>)
EMAIL_FROM=TravaillerEnCi <noreply@travaillerenci.ci>

# ---------------------------------------------------------------------------
# Connexion Google (SSO) — Option A du chantier « bouton Google »
#   1. Créez des credentials OAuth « Application Web » sur Google Cloud Console
#      (URI de redirection : <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback)
#   2. Renseignez GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
#   3. Passez NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=1 pour AFFICHER le bouton.
#   Tant que la variable publique n'est pas à 1, le bouton est masqué (le site
#   ne propose jamais une option qui échoue).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=0

# ---------------------------------------------------------------------------
# Notifications WhatsApp (Meta Cloud API — mêmes variables que le scraper)
#   WHATSAPP_NOTIFY_ENABLED=1 active l'envoi. Sans lui, aucune notification.
# ---------------------------------------------------------------------------
WHATSAPP_NOTIFY_ENABLED=0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TARGET_PHONE=

# ---------------------------------------------------------------------------
# Alertes candidat (digest scraper/alert_digest.py — workflow auto-publish.yml)
#   Fenêtre de « nouveauté » : contenus créés dans les N dernières heures.
# ---------------------------------------------------------------------------
ALERT_DIGEST_LOOKBACK_HOURS=24

# ---------------------------------------------------------------------------
# Sessions (signature HMAC des cookies httpOnly admin + utilisateurs)
#   À DÉFINIR absolument en production (chaîne longue et aléatoire).
# ---------------------------------------------------------------------------
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Scraper (workflows GitHub Actions)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
SCRAPER_SITES=
EXAM_SOURCES=
