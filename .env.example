# =============================================================================
# TravaillerEnCi — Variables d'environnement (scraper)
# =============================================================================
# Copie ce fichier en .env.local (gitignoré) et remplis les valeurs.
# Les secrets CI/Vercel ont la priorité sur .env.local.

# --- Gemini (Google AI Studio) ---
# Clé API pour la classification + réécriture Markdown des contenus scrapés.
# Sans elle, le scraper fonctionne en mode heuristique (pas d'IA).
GEMINI_API_KEY=

# Modèle Gemini principal (défaut : gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Modèles de repli si le modèle principal est saturé (séparés par virgules).
# Le quota est PAR MODÈLE — basculer sur un autre modèle contourne la limite.
# GEMINI_MODEL_FALLBACKS=gemini-3-flash-preview

# --- Groq (repli IA, 2e palier) ---
# Repli automatique si Gemini échoue (quota, timeout, JSON invalide).
# Le circuit breaker marque Groq indisponible dès le premier 429 quota.
GROQ_API_KEY=

# --- Cerebras (repli IA, 3e palier) ---
# Dernier palier IA avant le repli heuristique. API compatible OpenAI.
# Clé API : https://cloud.cerebras.ai (compte gratuit, modèle llama3.1-8b).
# Le circuit breaker marque Cerebras indisponible dès le premier 429 quota.
CEREBRAS_API_KEY=
# Modèle Cerebras (défaut : llama3.1-8b)
# CEREBRAS_MODEL=llama3.1-8b

# --- Scraper ---
# Timeout global du run en secondes (défaut : 900 = 15 min).
# Au-delà, le traitement des éléments restants est arrêté proprement
# et tout ce qui a déjà été traité est enregistré en base.
# SCRAPER_MAX_DURATION_SECONDS=900

# Délai minimum entre deux requêtes IA individuelles (secondes).
# Évite les 429 cascadants quand le batch échoue.
# INTER_REQUEST_DELAY=1.5

# =============================================================================
# Sécurité applicative — OBLIGATOIRES en production (fail-closed)
# =============================================================================
# En production, ces variables manquantes désactivent la fonction correspondante
# (aucun fallback secret n'est embarqué). En développement local, des valeurs de
# secours sont utilisées uniquement si ces variables sont absentes.

# Identifiants de connexion admin (/cz7tk/login).
# Sans eux en production : connexion refusée (HTTP 503).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret de signature des sessions admin + candidat (HMAC-SHA256).
# Sans lui en production : aucune session ne peut être créée/vérifiée.
# JWT_SECRET est accepté en substitution.
ADMIN_SESSION_SECRET=

# Jeton d'autorisation du pipeline CRON /api/news (Bearer <secret>).
# Sans lui : la route POST reste fermée (HTTP 401).
CRON_SECRET=

# Durée de validité de la session admin en heures (défaut : 12).
# ADMIN_SESSION_TTL_HOURS=12
