# =============================================================================
#  TravaillerEnCi — variables d'environnement (NOMS UNIQUEMENT, jamais de secrets)
#
#  Copier ce fichier vers `.env.local` (local, gitignoré) ou définir chaque
#  variable dans Vercel → Settings → Environment Variables (production).
#
#  ⚠️ NE JAMAIS committer de clé/valeur secrète. Si une clé fuite dans Git,
#  révoquez-la immédiatement puis remplacez-la.
# =============================================================================

# --- Base de données ----------------------------------------------------------
# NEXT_PUBLIC_DB_PROVIDER=sqlite            # sqlite (local) | supabase (production)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=                # serveur uniquement (écritures admin, contourne la RLS)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sessions (signature HMAC des cookies httpOnly) ---------------------------
# ADMIN_SESSION_SECRET=                     # secret aléatoire long, serveur uniquement
# JWT_SECRET=                               # repli utilisé si ADMIN_SESSION_SECRET absent
# ADMIN_SESSION_TTL_HOURS=12                # durée de validité de la session admin (défaut 12h)

# --- Site ----------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://travaillerenci.vercel.app
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=          # 1 pour afficher « Se connecter avec Google »
# GOOGLE_CLIENT_ID=                         # credentials OAuth « Application Web » (Google Cloud Console)
# GOOGLE_CLIENT_SECRET=

# --- Authentification -----------------------------------------------------------
# Vérification d'email par lien. DÉSACTIVÉE par défaut : le compte est créé
# directement vérifié et utilisable immédiatement (aucune dépendance à Resend).
# Réactiver APRÈS l'achat du domaine + configuration Resend (docs/EMAIL_DELIVERY.md) :
# EMAIL_VERIFICATION_ENABLED=false

# --- Sécurité admin (2FA + alertes) --------------------------------------------
# ADMIN_TOTP_SECRET=                        # secret TOTP base32 pour la 2FA (Google Authenticator)
#                                           # Générer : npx tsx -e "import speakeasy from 'speakeasy'; console.log(speakeasy.generateSecret({name:'TravaillerEnCi Admin'}).base32)"
# ADMIN_ALERT_ENABLED=                      # "1" pour activer les alertes de connexion échouée
# ADMIN_ALERT_WEBHOOK_URL=                  # webhook externe (n8n, Make…) — prioritaire sur WhatsApp direct
#
# Rate-limiting : le login admin bloque après 5 tentatives / 15 min par IP.
# Les alertes utilisent le même canal WhatsApp que les notifications concours :
# WHATSAPP_TOKEN=                           # jeton d'accès Meta WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=                 # ID du numéro WhatsApp Business
# WHATSAPP_TARGET_PHONE=                    # numéro destinataire (format international)

# --- Emails transactionnels (Resend) — optionnel à ce stade ----------------------
# RESEND_API_KEY=
# EMAIL_FROM=TravaillerEnCi <noreply@travaillerenci.ci>

# --- IA : enrichissement du scraper (Gemini principal, Groq en repli) ------------
# GEMINI_API_KEY=                           # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_FALLBACKS=gemini-3-flash-preview
# GROQ_API_KEY=                             # https://console.groq.com/keys — repli si Gemini échoue
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Outils de développement (locaux / scripts uniquement) -----------------------
# SCRAPER_SITES=educarriere,emploici,boursedetude   # filtre des sources (défaut sinon)
# EXAM_SOURCES=gucaci,ena,infas                     # filtre des sources concours (optionnel)
# SUPABASE_ACCESS_TOKEN=sbp_…                       # Personal Access Token Supabase : scripts/apply-*-migrations.ts
