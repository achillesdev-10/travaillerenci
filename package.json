{
  "name": "travaillerenci",
  "version": "1.0.0",
  "description": "TravaillerEnCi - Plateforme d'offres d'emploi en Côte d'Ivoire",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:setup": "tsx scripts/sqlite-setup.ts",
    "db:reset": "tsx scripts/sqlite-setup.ts --reset",
    "db:seed": "echo \"Plus de seed : les contenus proviennent du scraper (python scraper/scraper.py)\"",
    "db:dry": "tsx scripts/sqlite-setup.ts --dry-run",
    "db:migrate-exams": "tsx scripts/migrate-exams.ts",
    "db:seed-exams": "tsx scripts/seed-exams.ts",
    "db:apply-exams-migration": "tsx scripts/apply-exams-migration.ts",
    "db:apply-all": "tsx scripts/apply-all-migrations.ts",
    "db:apply-migrations": "tsx scripts/apply-content-migrations.ts",
    "db:sync-exams": "tsx scripts/sync-all-to-supabase.ts --tables=exam",
    "db:sync-all": "tsx scripts/sync-all-to-supabase.ts",
    "test:exam-phase": "tsx scripts/test-exam-phase.ts",
    "test:social": "node --require ./scripts/__stubs/server-only-stub.cjs --import tsx --test tests/social/*.test.ts",
    "test:assistant": "node --require ./scripts/__stubs/server-only-stub.cjs --import tsx scripts/test-assistant.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "test:e2e:prod:headed": "playwright test --config playwright.prod.config.ts --headed"
  },
  "keywords": [
    "emploi",
    "cote-divoire",
    "jobs",
    "offres",
    "travail"
  ],
  "author": "TravaillerEnCi Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "html2pdf.js": "^0.14.0",
    "next": "^16.2.12",
    "sharp": "^0.34.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
